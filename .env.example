# --- Database -------------------------------------------------------------
# Local dev uses SQLite. For production use PostgreSQL (e.g. Supabase):
# change `provider` in prisma/schema.prisma to "postgresql" and set the URL.
DATABASE_URL="file:./dev.db"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Daylight"
SUPPORT_EMAIL="support@example.com"

# Secret required to call POST /api/jobs/daily-delivery (cron). Use a long random value.
CRON_SECRET="change-me-to-a-long-random-string"

# --- Email ----------------------------------------------------------------
# "console" logs emails to the server output (dev). "resend" sends via Resend.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Daylight <hello@example.com>"
EMAIL_REPLY_TO=""

# --- Seed -----------------------------------------------------------------
# Optional: creates/promotes this account to admin when running `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- AI draft generation (admin only, optional) --------------------------------
# Leave GEMINI_API_KEY empty to turn AI drafting off. GEMINI_MODEL is configurable
# because Google rotates model names.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Push reminders (Web Push / VAPID) -----------------------------------------
# Generate with: npx web-push generate-vapid-keys   (leave empty to disable reminders)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"
