# --- Database -------------------------------------------------------------
# Local dev uses SQLite. For production use PostgreSQL (e.g. Supabase):
# change `provider` in prisma/schema.prisma to "postgresql" and set the URL.
DATABASE_URL="file:./dev.db"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Daylight"
SUPPORT_EMAIL="support@example.com"

# Secret required to call POST /api/jobs/daily-delivery (cron). Use a long random value.
CRON_SECRET="change-me-to-a-long-random-string"

# --- Email ----------------------------------------------------------------
# "console" logs emails to the server output (dev). "resend" sends via Resend.
# Real delivery happens ONLY when all four are set: EMAIL_PROVIDER="resend",
# RESEND_API_KEY, EMAIL_FROM on a domain verified in Resend (SPF + DKIM; add DMARC),
# and EMAIL_SENDING_ENABLED="true". If anything is missing, emails are logged, never
# sent, and the app keeps working. Check without sending: npm run email:check
# (it reads the shell environment, not this file).
EMAIL_PROVIDER="console"
# Resend API key with "Sending access", restricted to your domain. Mark it Sensitive in Vercel.
RESEND_API_KEY=""
# Must use your verified sending domain. example.com addresses are rejected.
EMAIL_FROM="Daylight <hello@example.com>"
# Optional: where replies go (e.g. your support inbox).
EMAIL_REPLY_TO=""
# Safety switch. Anything other than "true" (e.g. "false") disables real email delivery,
# even when Resend is fully configured. Set "true" only when you're ready to send.
EMAIL_SENDING_ENABLED="false"

# --- Seed -----------------------------------------------------------------
# Optional: creates/promotes this account to admin when running `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- AI draft generation (admin only, optional) --------------------------------
# Leave GEMINI_API_KEY empty to turn AI drafting off. GEMINI_MODEL is configurable
# because Google rotates model names.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Push reminders (Web Push / VAPID) -----------------------------------------
# Generate with: npx web-push generate-vapid-keys   (leave empty to disable reminders)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"
